# Settings of benethos-mailbox-agents, see docs/mailbox-agents/concept/configuration.md.
#
# One process runs one agent, so one file describes one agent. Copy this
# file to .env beside it, or set the same names in the environment. A
# secret may be given as a file instead: add _FILE to its name and name
# the file, as a container mounts it. A secret given directly wins.

# The mailbox service and this agent's token.
MAILBOX_AGENTS_SERVICE_URL=https://mailbox.example.test
MAILBOX_AGENTS_SERVICE_TOKEN=
# MAILBOX_AGENTS_SERVICE_TOKEN_FILE=/run/secrets/service_token
# http to another machine carries the token unencrypted, so it is refused
# unless allowed here, as between two containers on one network.
MAILBOX_AGENTS_SERVICE_ALLOW_HTTP=false

# The model gateway and this agent's key.
MAILBOX_AGENTS_GATEWAY_URL=https://gateway.example.test/v1
# http to another machine carries the key and the mail unencrypted, so it
# is refused unless allowed here, as between two containers on one network.
MAILBOX_AGENTS_GATEWAY_ALLOW_HTTP=false
MAILBOX_AGENTS_GATEWAY_KEY=
# MAILBOX_AGENTS_GATEWAY_KEY_FILE=/run/secrets/gateway_key
# How long one model call may take, in seconds.
MAILBOX_AGENTS_GATEWAY_TIMEOUT_SECONDS=120

# The alias the gateway resolves to a model.
MAILBOX_AGENTS_MODEL=mail-classifier

# The certificates of the authorities https to the mailbox service and the
# gateway trusts, PEM, in place of the public roots: for a service or
# gateway with a certificate of an own CA. SSL_CERT_FILE and proxy
# variables are not read.
# MAILBOX_AGENTS_CA_FILE=

# The accounts to work on, comma separated. All the user may read when unset.
# MAILBOX_AGENTS_ACCOUNTS=

# shadow, keyword or full. shadow when unset.
MAILBOX_AGENTS_STAGE=shadow

# The keyword the agent sets. Each agent has its own default, agent-<word>:
# agent-invoice, agent-awaiting-reply, agent-inquiry, agent-sorted. Lower
# case letters, digits and dashes. Set it in the env file of one agent
# only: here it would hold for every agent these settings start.
# MAILBOX_AGENTS_KEYWORD=

# How often the feed is read and the clock asked, in seconds.
MAILBOX_AGENTS_POLL_SECONDS=60
MAILBOX_AGENTS_TICK_SECONDS=900

# Refused answers of the model before a message is given up as failed.
MAILBOX_AGENTS_MAX_ATTEMPTS=5
# The longest wait between two attempts, in seconds.
MAILBOX_AGENTS_BACKOFF_CEILING_SECONDS=3600
# The days backfill runs over when the feed state has expired.
MAILBOX_AGENTS_BACKFILL_DAYS=7

# Where the state files live, one <agent>.db per agent. Unset: in this
# repository data/benethos-mailbox-agents below the working directory,
# with a settings file named by --env-file or MAILBOX_AGENTS_ENV_FILE
# that folder beside the file, and installed alone the data folder of
# the operating system. A relative path counts from the folder of a
# named settings file.
# MAILBOX_AGENTS_DATA_DIR=data/benethos-mailbox-agents

# Keep the full request and answer of each model call this many days.
# 0 keeps none.
MAILBOX_AGENTS_PROMPT_RETENTION_DAYS=0

# The port of the metrics endpoint. 0 serves none, the containers use 9464.
MAILBOX_AGENTS_METRICS_PORT=0

# DEBUG, INFO, WARNING or ERROR.
MAILBOX_AGENTS_LOG_LEVEL=INFO

# --- invoices, docs/mailbox-agents/concept/agent-invoices.md ---
# The folders it looks in besides the inbox, comma separated. Parent/* is
# every folder directly below Parent, * every folder at the top without a
# role. The inbox alone when unset.
# MAILBOX_AGENTS_INVOICES_FOLDERS=Providers/*
# Where an invoice goes, below the folder it lies in. Marked only when unset.
# MAILBOX_AGENTS_INVOICES_SUBFOLDER={folder}/Rechnungen
# Where an invoice found in the inbox goes. Marked only when unset.
# MAILBOX_AGENTS_INVOICES_INBOX_FOLDER=

# --- awaiting_reply, docs/mailbox-agents/concept/agent-awaiting-reply.md ---
# Working days, Monday to Friday, until an open item is due.
# MAILBOX_AGENTS_REPLY_DAYS=3

# --- inquiries, docs/mailbox-agents/concept/agent-inquiries.md ---
# Sender domains and phrases the baseline knows besides its own, made
# after inquiries.example.json beside this file. Optional.
# MAILBOX_AGENTS_INQUIRIES_PATTERNS_FILE=config/benethos-mailbox-agents/inquiries.json

# --- sorting, docs/mailbox-agents/concept/agent-sorting.md ---
# The groups and their folders, JSON, made after sorting.example.json
# beside this file. A group with a topic is chosen by a model where no
# sender rule settles a message: sorting then needs the gateway settings
# above.
# MAILBOX_AGENTS_SORTING_FILE=config/benethos-mailbox-agents/sorting.json
