# Settings of the REST service (benethos-mailbox-api). Copy to .env in this
# folder (not versioned). The service reads config/benethos-mailbox-api/.env
# relative to the folder it is started from, normally the repository root.
# Every value here is the default; set only what you want to change. Real
# environment variables win over this file.

# Where the database lives. A relative path counts from the working directory.
MAILBOX_API_DATA_DIR=data/benethos-mailbox-api
# sqlite, or memory to keep nothing
MAILBOX_API_STORAGE=sqlite

MAILBOX_API_HOST=127.0.0.1
MAILBOX_API_PORT=8080
MAILBOX_API_LOG_LEVEL=INFO

# Optional built-in admin key. Without it and without any user, /v1 answers
# 503 setup_required; see `benethos-mailbox-api users create-admin`.
# MAILBOX_API_KEY=

# Where the master key lives: keyring (the OS credential store of the user
# running the service), file or env.
MAILBOX_API_KEY_PROVIDER=keyring
# For file: a path outside the data folder, e.g. in this config folder.
# MAILBOX_API_KEY_FILE=
# For env: the recovery key.
# MAILBOX_API_MASTER_KEY=

# Autodiscovery: ask Thunderbird's ISPDB (tells Mozilla the domain).
MAILBOX_API_DISCOVERY_ISPDB=true
# Autodiscovery: hosts that may resolve to private addresses, a JSON list.
MAILBOX_API_DISCOVERY_INTERNAL_HOSTS=[]

# Sync worker: seconds between two polls of every folder, 0 switches it off.
MAILBOX_API_SYNC_INTERVAL=300
# Sync worker: watch the inbox over IMAP IDLE (a second connection per
# account).
MAILBOX_API_SYNC_IDLE=true

# The address people reach the service at, e.g. https://mail.example.org
# behind a proxy. Builds the OAuth redirect address
# (<public url>/ui/oauth/<provider>/callback), which must be registered with
# the provider exactly so. Empty: taken from each request.
# MAILBOX_API_PUBLIC_URL=

# Microsoft accounts (Outlook.com, Microsoft 365) sign in with OAuth, through
# an app registered in Microsoft Entra ID for this deployment. Without a
# client id they cannot be connected.
# MAILBOX_API_OAUTH_MICROSOFT_CLIENT_ID=
# The client secret: better from a file (a container secret) than here.
# MAILBOX_API_OAUTH_MICROSOFT_CLIENT_SECRET_FILE=
# MAILBOX_API_OAUTH_MICROSOFT_CLIENT_SECRET=
# Who may sign in: common (personal and work or school accounts), consumers,
# organizations, or one tenant's id or domain.
MAILBOX_API_OAUTH_MICROSOFT_TENANT=common
