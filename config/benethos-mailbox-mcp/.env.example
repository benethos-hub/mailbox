# Settings of the MCP server (benethos-mailbox-mcp). Copy to .env in this
# folder (not versioned), or into its config folder of the operating
# system, e.g. %LOCALAPPDATA%\benethos-mailbox-mcp\config\.env on Windows or
# ~/.config/benethos-mailbox-mcp/.env on Linux. A file kept elsewhere is
# named with --env-file or MAILBOX_MCP_ENV_FILE. The environment wins over
# this file, the command line over both. An MCP client that starts the
# server over stdio may pass these in its own configuration instead.
# The file holds the API token: keep it readable by its owner alone.

# Where the REST service answers.
MAILBOX_SERVICE_URL=http://127.0.0.1:8080
# The API token of the user the MCP server acts as.
# MAILBOX_SERVICE_TOKEN=

# Over HTTP (--transport streamable-http). The command line wins.
# MAILBOX_MCP_TRANSPORT=streamable-http
# MAILBOX_MCP_HOST=127.0.0.1
# MAILBOX_MCP_PORT=8000
# MAILBOX_MCP_PATH=/mcp
# MAILBOX_MCP_ALLOWED_HOSTS=
# MAILBOX_MCP_ALLOWED_ORIGINS=
# MAILBOX_MCP_LOG_LEVEL=INFO
# What MCP clients must send as Authorization: Bearer <token>.
# MAILBOX_MCP_BEARER_TOKEN=
