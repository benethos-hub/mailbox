# Settings of the MCP server (benethos-mailbox-mcp). Template only for now:
# the MCP server reads these from the environment and does not read a .env
# file yet. An MCP client that starts it over stdio passes them in its own
# configuration.

# Where the REST service answers.
MAILBOX_SERVICE_URL=http://127.0.0.1:8080
# The API token of the user the MCP server acts as.
# MAILBOX_SERVICE_TOKEN=

# Over HTTP (--transport streamable-http). The command line wins.
# MAILBOX_MCP_TRANSPORT=streamable-http
# MAILBOX_MCP_HOST=127.0.0.1
# MAILBOX_MCP_PORT=8000
# MAILBOX_MCP_PATH=/mcp
# MAILBOX_MCP_ALLOWED_HOSTS=
# MAILBOX_MCP_ALLOWED_ORIGINS=
# MAILBOX_MCP_LOG_LEVEL=INFO
# What MCP clients must send as Authorization: Bearer <token>.
# MAILBOX_MCP_BEARER_TOKEN=
