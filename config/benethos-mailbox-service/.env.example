# Settings of the REST service (benethos-mailbox-service). Copy to .env in this
# folder (not versioned). The service reads config/benethos-mailbox-service/.env
# relative to the folder it is started from, normally the repository root.
# A file kept elsewhere is named with --env-file or MAILBOX_SERVICE_ENV_FILE.
# Every value here is the default. Set only what you want to change. Real
# environment variables win over this file.

# Where the database lives. A relative path counts from the working
# directory, or from the folder of a file named with --env-file.
MAILBOX_SERVICE_DATA_DIR=data/benethos-mailbox-service
# sqlite, or memory to keep nothing
MAILBOX_SERVICE_STORAGE=sqlite

MAILBOX_SERVICE_HOST=127.0.0.1
MAILBOX_SERVICE_PORT=8080
# critical, error, warning, info, debug or trace
MAILBOX_SERVICE_LOG_LEVEL=INFO

# Where the master key lives: keyring (the OS credential store of the user
# running the service), file or env.
MAILBOX_SERVICE_KEY_PROVIDER=keyring
# For file: a path outside the data folder, e.g. in this config folder.
# MAILBOX_SERVICE_KEY_FILE=
# For env: the recovery key.
# MAILBOX_SERVICE_MASTER_KEY=

# Autodiscovery: ask Thunderbird's ISPDB (tells Mozilla the domain).
MAILBOX_SERVICE_DISCOVERY_ISPDB=true
# Hosts that may resolve to private addresses, a JSON list, e.g. an internal
# mail server: autodiscovery may look them up and accounts may use them.
# Every other host must resolve to public addresses only.
MAILBOX_SERVICE_DISCOVERY_INTERNAL_HOSTS=[]

# Sync worker: seconds between two polls of every folder, 0 switches it off.
MAILBOX_SERVICE_SYNC_INTERVAL=300
# Sync worker: watch the inbox over IMAP IDLE (a second connection per
# account).
MAILBOX_SERVICE_SYNC_IDLE=true
# Sync worker: accounts watched over IDLE at once, each in a thread of its
# own. Further accounts are polled only.
MAILBOX_SERVICE_SYNC_WATCHERS=50
# Change feed: days a change is kept.
MAILBOX_SERVICE_CHANGES_DAYS=7
# The audits of sends and of administration: days a record is kept,
# 0 keeps every record.
MAILBOX_SERVICE_AUDIT_DAYS=90
# Webhooks: tries of a post before its events are dropped, the pause after
# the first failure in seconds (doubled after each further one, up to the
# longest), and how long a receiver may take to answer.
MAILBOX_SERVICE_WEBHOOK_ATTEMPTS=8
MAILBOX_SERVICE_WEBHOOK_FIRST_RETRY=30
MAILBOX_SERVICE_WEBHOOK_LONGEST_RETRY=3600
MAILBOX_SERVICE_WEBHOOK_TIMEOUT=10

# Requests a minute per API token or UI session. A burst of half as many
# passes at once. A refused request answers 429 with Retry-After. 0 switches
# the limit off.
MAILBOX_SERVICE_RATE_LIMIT_PER_MINUTE=120
# The same per client address, for requests without a credential: the
# sign-in page, its files, a wrong path. Behind a reverse proxy set
# MAILBOX_SERVICE_FORWARDED_ALLOW_IPS below, or every visitor counts as the
# proxy's address.
MAILBOX_SERVICE_RATE_LIMIT_ANONYMOUS_PER_MINUTE=30
# IMAP: requests a minute to one account's server, and how many pass at
# once. An account's own max_requests_per_minute wins over the rate.
MAILBOX_SERVICE_IMAP_REQUESTS_PER_MINUTE=60
MAILBOX_SERVICE_IMAP_BURST=10
# IMAP: attempts at a server that does not answer, within one request.
# After the last the server rests: the first pause in seconds, doubled
# after each further failure, up to the longest.
MAILBOX_SERVICE_IMAP_ATTEMPTS=3
MAILBOX_SERVICE_IMAP_FIRST_PAUSE=30
MAILBOX_SERVICE_IMAP_LONGEST_PAUSE=900
# Sign-in: failed attempts from one client address within the lockout time
# that lock the address out, and for how many minutes. Wrong API tokens
# and wrong UI passwords count alike. A valid token passes regardless.
MAILBOX_SERVICE_SIGN_IN_FAILURES=10
MAILBOX_SERVICE_SIGN_IN_LOCKOUT_MINUTES=15
# Seconds a user name waits after as many failed sign-ins from anywhere.
MAILBOX_SERVICE_SIGN_IN_NAME_WAIT=60
# Password hashes running at once. Each takes 32 MiB of memory.
MAILBOX_SERVICE_PASSWORD_HASHES_AT_ONCE=2
# UI: hours a session lives without a request.
MAILBOX_SERVICE_SESSION_IDLE_HOURS=8
# Autodiscovery: lookups a minute per user.
MAILBOX_SERVICE_DISCOVERY_PER_MINUTE=10

# The address people reach the service at, e.g. https://mail.example.org
# behind a proxy. The OAuth redirect address is built from it
# (<public url>/ui/oauth/<provider>/callback). It must be registered with
# the provider exactly so. Empty: taken from each request.
# MAILBOX_SERVICE_PUBLIC_URL=
# Behind a reverse proxy: its address (several separated by commas, or *),
# whose X-Forwarded-For, -Proto and -Host headers are believed. They give the
# client address the sign-in throttle and the request limit count, and the
# scheme the session cookie's Secure flag follows. Empty: only a proxy on
# 127.0.0.1 is believed.
# MAILBOX_SERVICE_FORWARDED_ALLOW_IPS=

# Microsoft accounts (Outlook.com, Microsoft 365) sign in with OAuth, through
# an app registered in Microsoft Entra ID for this deployment. Without a
# client id they cannot be connected.
# MAILBOX_SERVICE_OAUTH_MICROSOFT_CLIENT_ID=
# The client secret: better from a file (a container secret) than here.
# MAILBOX_SERVICE_OAUTH_MICROSOFT_CLIENT_SECRET_FILE=
# MAILBOX_SERVICE_OAUTH_MICROSOFT_CLIENT_SECRET=
# Who may sign in: common (personal and work or school accounts), consumers,
# organizations, or one tenant's id or domain.
MAILBOX_SERVICE_OAUTH_MICROSOFT_TENANT=common
