# Settings of the REST service (benethos-mailbox-service). Copy to .env in this
# folder (not versioned). The service reads config/benethos-mailbox-service/.env
# relative to the folder it is started from, normally the repository root.
# Every value here is the default. Set only what you want to change. Real
# environment variables win over this file.

# Where the database lives. A relative path counts from the working directory.
MAILBOX_SERVICE_DATA_DIR=data/benethos-mailbox-service
# sqlite, or memory to keep nothing
MAILBOX_SERVICE_STORAGE=sqlite

MAILBOX_SERVICE_HOST=127.0.0.1
MAILBOX_SERVICE_PORT=8080
MAILBOX_SERVICE_LOG_LEVEL=INFO

# Optional built-in admin key. Without it and without any user, /v1 answers
# 503 setup_required. See `benethos-mailbox-service users create-admin`.
# MAILBOX_SERVICE_KEY=

# Where the master key lives: keyring (the OS credential store of the user
# running the service), file or env.
MAILBOX_SERVICE_KEY_PROVIDER=keyring
# For file: a path outside the data folder, e.g. in this config folder.
# MAILBOX_SERVICE_KEY_FILE=
# For env: the recovery key.
# MAILBOX_SERVICE_MASTER_KEY=

# Autodiscovery: ask Thunderbird's ISPDB (tells Mozilla the domain).
MAILBOX_SERVICE_DISCOVERY_ISPDB=true
# Hosts that may resolve to private addresses, a JSON list, e.g. an internal
# mail server: autodiscovery may look them up and accounts may use them.
# Every other host must resolve to public addresses only.
MAILBOX_SERVICE_DISCOVERY_INTERNAL_HOSTS=[]

# Sync worker: seconds between two polls of every folder, 0 switches it off.
MAILBOX_SERVICE_SYNC_INTERVAL=300
# Sync worker: watch the inbox over IMAP IDLE (a second connection per
# account).
MAILBOX_SERVICE_SYNC_IDLE=true
# Change feed: days a change is kept.
MAILBOX_SERVICE_CHANGES_DAYS=7

# The address people reach the service at, e.g. https://mail.example.org
# behind a proxy. The OAuth redirect address is built from it
# (<public url>/ui/oauth/<provider>/callback). It must be registered with
# the provider exactly so. Empty: taken from each request.
# MAILBOX_SERVICE_PUBLIC_URL=
# Behind a reverse proxy: its address (several separated by commas, or *),
# whose X-Forwarded-For, -Proto and -Host headers are believed. They give the
# client address the sign-in throttle counts and the scheme the session
# cookie's Secure flag follows. Empty: only a proxy on 127.0.0.1 is believed.
# MAILBOX_SERVICE_FORWARDED_ALLOW_IPS=

# Microsoft accounts (Outlook.com, Microsoft 365) sign in with OAuth, through
# an app registered in Microsoft Entra ID for this deployment. Without a
# client id they cannot be connected.
# MAILBOX_SERVICE_OAUTH_MICROSOFT_CLIENT_ID=
# The client secret: better from a file (a container secret) than here.
# MAILBOX_SERVICE_OAUTH_MICROSOFT_CLIENT_SECRET_FILE=
# MAILBOX_SERVICE_OAUTH_MICROSOFT_CLIENT_SECRET=
# Who may sign in: common (personal and work or school accounts), consumers,
# organizations, or one tenant's id or domain.
MAILBOX_SERVICE_OAUTH_MICROSOFT_TENANT=common
