# Mailbox in operation: what compose.yaml reads. Copy to .env beside it
# (setup.sh does that on its first run). The settings of the service
# itself go into service.env (template service.env.example).

# The version of the images. To update, change it, then:
#   docker compose pull && docker compose up -d
MAILBOX_VERSION=0.4.0

# Optional, comma-separated:
#   https  Caddy in front with a certificate for MAILBOX_DOMAIN
#   mcp    the MCP server instances of compose.override.yaml
COMPOSE_PROFILES=

# The port of the service on the host, on 127.0.0.1 only.
MAILBOX_SERVICE_PORT=8080

# https: the domain Caddy serves.
MAILBOX_DOMAIN=

# https: where the certificate comes from (Caddyfile).
#   acme      Let's Encrypt. The DNS of MAILBOX_DOMAIN names this host,
#             and the ports 80 and 443 reach it from the internet.
#   internal  the CA of Caddy, in a network without access from the
#             internet. Clients must trust its root certificate.
#   files     your own, e.g. of a company CA, in secrets/tls/:
#             server.pem (with its chain) and server.key.
MAILBOX_TLS=acme

# A reverse proxy of your own instead of https: the address it serves,
# and where its requests come from, the network's gateway.
# MAILBOX_SERVICE_PUBLIC_URL=https://mail.example.org
# MAILBOX_SERVICE_FORWARDED_ALLOW_IPS=172.30.80.1
