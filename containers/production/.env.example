# Mailbox in operation: what compose.yaml reads. Copy to .env beside it
# (setup.sh does that on its first run). It can hold the tokens of the MCP
# server: keep it readable by its owner alone. The settings of the
# service itself go into service.env (template service.env.example).

# The version of the images. To update, change it, then:
#   docker compose pull && docker compose up -d
MAILBOX_VERSION=0.2.0

# Optional parts, comma-separated: mcp (the MCP server over HTTP) and
# https (Caddy in front, with a certificate for MAILBOX_DOMAIN).
COMPOSE_PROFILES=

# The ports on the host, on 127.0.0.1 only.
MAILBOX_SERVICE_PORT=8080
MAILBOX_MCP_PORT=8000

# https: the domain Caddy serves. Its DNS must name this host, and the
# ports 80 and 443 must reach it from the internet for Let's Encrypt.
MAILBOX_DOMAIN=

# A reverse proxy of your own instead of https: the address it serves,
# and where its requests come from, the network's gateway.
# MAILBOX_SERVICE_PUBLIC_URL=https://mail.example.org
# MAILBOX_SERVICE_FORWARDED_ALLOW_IPS=172.30.80.1

# mcp: the API token of the user the MCP server acts as, made on that
# user's page in the UI, and what the server's own clients must send as
# bearer token, e.g. from `openssl rand -base64 32`.
MAILBOX_MCP_API_TOKEN=
MAILBOX_MCP_BEARER_TOKEN=
