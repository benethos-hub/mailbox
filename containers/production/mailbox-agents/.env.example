# The settings of compose.yaml itself. Copy to .env beside it.
# Each agent's own settings are in agents/<name>/.env.

# The version of the image, as released. Best with the digest of the
# release behind it, as <version>@sha256:<digest>: a tag can be moved, a digest
# cannot, so a moved tag is never pulled without notice. The digest is on
# the package page and in the log of the release.
MAILBOX_AGENTS_VERSION=0.10.0

# Where each agent's metrics are published, on 127.0.0.1 only.
COUNTING_METRICS_PORT=9470
INVOICES_METRICS_PORT=9471
AWAITING_REPLY_METRICS_PORT=9472
INQUIRIES_METRICS_PORT=9473
SORTING_METRICS_PORT=9474
