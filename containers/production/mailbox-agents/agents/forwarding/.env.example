# Settings of the agent forwarding in operation, see docs/mailbox-agents/concept/configuration.md.
# Copy to .env beside this file. The token is a file under
# ../../secrets/forwarding/, named service_token, readable by uid 10001.
# compose.yaml names it, so it is not set here. forwarding asks no model, so
# it needs no gateway and no key. Its user in the mailbox service has
# mail.read and drafts, not mail.write and not send.

# The mailbox service, as the container reaches it. http only between two
# containers on one network, which MAILBOX_AGENTS_SERVICE_ALLOW_HTTP then
# allows.
MAILBOX_AGENTS_SERVICE_URL=https://mailbox.example.test
# MAILBOX_AGENTS_SERVICE_ALLOW_HTTP=false

# The certificates of the authorities https trusts, PEM, in place of the
# public roots, for an upstream with a certificate of an own CA. A path
# inside the container: mount the file there. SSL_CERT_FILE and proxy
# variables are not read.
# MAILBOX_AGENTS_CA_FILE=

# The accounts to work on, comma separated. All the user may read when unset.
# MAILBOX_AGENTS_ACCOUNTS=

# shadow, suggest or full. A new agent starts in shadow. forwarding drafts in
# suggest and in full and records in shadow. It sends nothing in any stage.
MAILBOX_AGENTS_STAGE=shadow

# The rules, which keywords go to which addresses, are forwarding.json
# beside this file (forwarding.example.json shows it). compose.yaml names it.

# The state in a database of its own on a PostgreSQL server of yours, in
# place of the volume: README.md, "On PostgreSQL". The password of the
# role is a file under ../../secrets/forwarding/, named database_password.
# MAILBOX_AGENTS_STORAGE=postgres
# MAILBOX_AGENTS_DATABASE_URL=postgresql://agent_forwarding@db.example.org:5432/agent_forwarding
# MAILBOX_AGENTS_DATABASE_PASSWORD_FILE=/run/secrets/database_password
# MAILBOX_AGENTS_DATABASE_TLS=verify
# MAILBOX_AGENTS_DATABASE_CA_FILE=
# The read role of the cockpit, given the read at each start.
# MAILBOX_AGENTS_DATABASE_READERS=agents_read
