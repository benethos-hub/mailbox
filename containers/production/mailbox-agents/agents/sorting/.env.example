# Settings of the agent sorting in operation, see docs/mailbox-agents/concept/configuration.md.
# Copy to .env beside this file. The token is a file under
# ../../secrets/sorting/, named service_token, readable by uid 10001.
# compose.yaml names it, so it is not set here. sorting asks a model only
# when a group of sorting.json has a topic. Only then it needs the gateway
# below and a key, a file named gateway_key in the same folder.

# The mailbox service, as the container reaches it. http only between two
# containers on one network, which MAILBOX_AGENTS_SERVICE_ALLOW_HTTP then
# allows.
MAILBOX_AGENTS_SERVICE_URL=https://mailbox.example.test
# MAILBOX_AGENTS_SERVICE_ALLOW_HTTP=false

# The certificates of the authorities https trusts, PEM, in place of the
# public roots, for an upstream with a certificate of an own CA. A path
# inside the container: mount the file there. SSL_CERT_FILE and proxy
# variables are not read.
# MAILBOX_AGENTS_CA_FILE=

# The accounts to work on, comma separated. All the user may read when unset.
# MAILBOX_AGENTS_ACCOUNTS=

# shadow, keyword or full. A new agent starts in shadow.
MAILBOX_AGENTS_STAGE=shadow

# The groups and their folders are sorting.json beside this file
# (sorting.example.json shows it). compose.yaml names it.

# Only for a list with a topic: the model gateway, the alias it resolves,
# and the file of the key, which compose.yaml mounts with the token.
# MAILBOX_AGENTS_GATEWAY_URL=https://gateway.example.test/v1
# http only between two containers on one network, which this allows.
# MAILBOX_AGENTS_GATEWAY_ALLOW_HTTP=false
# MAILBOX_AGENTS_MODEL=mail-classifier
# MAILBOX_AGENTS_GATEWAY_KEY_FILE=/run/secrets/gateway_key
