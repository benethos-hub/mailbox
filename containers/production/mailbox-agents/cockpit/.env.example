# Settings of the cockpit in operation, see docs/mailbox-agents/concept/cockpit.md.
# Copy to .env beside this file. Its secret is a file under
# ../secrets/cockpit/, named cockpit_secret, readable by uid 10001.
# compose.yaml names it, and the folder of the state files, so neither
# is set here.

# Subject and sender beside the ids: the mailbox service, and a token of
# a user of its own with mail.read alone, as a file under
# ../secrets/cockpit/ named service_token. Without both the cockpit shows
# the ids alone.
# MAILBOX_AGENTS_SERVICE_URL=https://mailbox.example.test
# MAILBOX_AGENTS_SERVICE_TOKEN_FILE=/run/secrets/service_token
# MAILBOX_AGENTS_SERVICE_ALLOW_HTTP=false
# MAILBOX_AGENTS_CA_FILE=

# DEBUG, INFO, WARNING or ERROR.
MAILBOX_AGENTS_LOG_LEVEL=INFO
