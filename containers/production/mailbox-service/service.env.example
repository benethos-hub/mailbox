# Further settings of the service, MAILBOX_SERVICE_*. Copy to service.env
# beside compose.yaml and set what you want to change. Every setting and
# its default: packages/mailbox-service/README.md, "Settings".
#
# The image sets the host, the data folder and the key file already. The
# public address and the proxy go into .env.

# MAILBOX_SERVICE_LOG_LEVEL=info
# MAILBOX_SERVICE_LOG_FORMAT=json
# MAILBOX_SERVICE_SYNC_INTERVAL=300
# MAILBOX_SERVICE_METRICS=false
# MAILBOX_SERVICE_AUDIT_DAYS=90
# MAILBOX_SERVICE_OUTBOX_RETRY_HOURS=48

# PostgreSQL as the database, with postgres in COMPOSE_PROFILES of .env.
# setup.sh makes the role mailbox and its password. TLS is off: the
# service reaches the database only in the network of this compose file,
# which has no way out.
# MAILBOX_SERVICE_STORAGE=postgres
# MAILBOX_SERVICE_DATABASE_URL=postgresql://mailbox@postgres:5432/mailbox
# MAILBOX_SERVICE_DATABASE_PASSWORD_FILE=/run/secrets/database_password
# MAILBOX_SERVICE_DATABASE_TLS=off
