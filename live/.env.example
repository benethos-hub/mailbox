# Copy to live/.env (not versioned) and fill in. Only accounts listed here
# count as confirmed test accounts (CLAUDE.md, golden rule 1).

# Optional: the IMAP server. Without it the smoke run uses what
# autodiscovery finds for each address.
LIVE_IMAP_HOST=
LIVE_IMAP_PORT=
# tls or starttls
LIVE_IMAP_SECURITY=

# Test accounts, numbered from 1. USERNAME defaults to the address.
LIVE_ACCOUNT_1_EMAIL=test1@example.org
LIVE_ACCOUNT_1_PASSWORD=
LIVE_ACCOUNT_1_USERNAME=

LIVE_ACCOUNT_2_EMAIL=
LIVE_ACCOUNT_2_PASSWORD=
LIVE_ACCOUNT_2_USERNAME=

# Optional: the SMTP server of the test accounts, for the checks that
# send (live/mailbox-service/changes.py, live/mailbox-service/ui.py, live/mailbox-mcp/mcp_stdio.py). They send
# between account 1 and account 2 only, never to anyone else. Without it
# the checks use what autodiscovery finds, with the IMAP password.
LIVE_SMTP_HOST=
LIVE_SMTP_PORT=
# tls or starttls
LIVE_SMTP_SECURITY=

# Optional: live/mailbox-service/microsoft.py, the microsoft adapter against a Microsoft test
# account. It needs the test account's address. Being listed here confirms it
# as a test account. The check sends one mail from it to test account 1, and
# to no one else. With --project it signs in through the project's app and
# needs nothing more. Without, an app of your own (docs/mailbox-service/MICROSOFT.md) with
# the redirect URI http://localhost:8080/ui/oauth/microsoft/callback.
LIVE_MICROSOFT_CLIENT_ID=
LIVE_MICROSOFT_CLIENT_SECRET=
# common by default
LIVE_MICROSOFT_TENANT=
LIVE_MICROSOFT_EMAIL=

# Optional: live/mailbox-service/gmail.py, the gmail adapter against a Gmail test account.
# It needs the test account's address. Being listed here confirms it as a
# test account. The check sends one mail from it to test account 1, and to
# no one else. It signs in through a Google client of your own
# (docs/mailbox-service/GOOGLE.md) with the redirect URI
# http://localhost:8080/ui/oauth/gmail/callback.
LIVE_GOOGLE_CLIENT_ID=
LIVE_GOOGLE_CLIENT_SECRET=
LIVE_GMAIL_EMAIL=
# Optional: the test mail server of containers/test-mail-server/, made by
# its setup.sh. The file named here lists its accounts and passwords, and
# being named here confirms them as test accounts. Checks that use them
# trust the test CA in tls/ beside that file: live/mailbox-service/pop3.py, live/mailbox-service/jmap.py,
# live/mailbox-service/imap.py.
LIVE_TEST_SERVER_ACCOUNTS=containers/test-mail-server/secrets/accounts.env
# Optional: the file of the test database of containers/test-database/,
# made by its setup.sh, for live/mailbox-service/postgres.py. Without
# it, that file at its place in the repository.
LIVE_TEST_DATABASE=containers/test-database/secrets/tests.env
# Optional: the command of Docker that reaches the test database's
# container, for live/mailbox-service/postgres.py and
# live/mailbox-agents/postgres_state.py. Without it, docker.
LIVE_DOCKER=docker
