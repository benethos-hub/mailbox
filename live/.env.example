# Copy to live/.env (not versioned) and fill in. Only accounts listed here
# count as confirmed test accounts (CLAUDE.md, golden rule 1).

# Optional: the IMAP server. Without it the smoke run uses what
# autodiscovery finds for each address.
LIVE_IMAP_HOST=
LIVE_IMAP_PORT=
# tls or starttls
LIVE_IMAP_SECURITY=

# Test accounts, numbered from 1. USERNAME defaults to the address.
LIVE_ACCOUNT_1_EMAIL=test1@example.org
LIVE_ACCOUNT_1_PASSWORD=
LIVE_ACCOUNT_1_USERNAME=

LIVE_ACCOUNT_2_EMAIL=
LIVE_ACCOUNT_2_PASSWORD=

# Optional: the SMTP server for live/changes.py, which sends one test mail
# from account 2 to account 1 and never to anyone else. Without it the
# script uses what autodiscovery finds, with the IMAP password.
LIVE_SMTP_HOST=
LIVE_SMTP_PORT=
# tls or starttls
LIVE_SMTP_SECURITY=
